<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window animation styles -->
    <style name="Animation.Cubic.None" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/cubic_none</item>
        <item name="android:windowExitAnimation">@anim/cubic_none</item>
    </style>

    <style name="Animation.Cubic.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/cubic_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/cubic_dialog_exit</item>
    </style>

    <style name="Animation.Cubic.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/cubic_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/cubic_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/cubic_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/cubic_activity_close_exit</item>
    </style>

    <style name="Animation.Cubic.ActivityNone" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/cubic_none</item>
        <item name="android:activityOpenExitAnimation">@anim/cubic_none</item>
        <item name="android:activityCloseEnterAnimation">@anim/cubic_none</item>
        <item name="android:activityCloseExitAnimation">@anim/cubic_none</item>
    </style>

    <!-- Overlays applied by AnimationManager for the animation types the user enabled -->
    <style name="ThemeOverlay.Cubic.Animations.Dialogs" parent="">
        <item name="cubicDialogAnimations">@style/Animation.Cubic.Dialog</item>
    </style>

    <style name="ThemeOverlay.Cubic.Animations.Buttons" parent="">
        <item name="cubicPressAnimator">@animator/cubic_press_scale</item>
    </style>

    <!-- Themed button defaults, the press animator is empty unless the overlay above is applied -->
    <style name="Widget.Cubic.Button" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">?attr/cubicPressAnimator</item>
    </style>

    <!-- Text button (primary coloured label, no fill) with the same press animator -->
    <style name="Widget.Cubic.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:stateListAnimator">?attr/cubicPressAnimator</item>
    </style>

    <style name="Widget.Cubic.ImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:stateListAnimator">?attr/cubicPressAnimator</item>
    </style>
</resources>
